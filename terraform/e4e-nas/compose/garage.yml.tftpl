# Garage S3 object store — single-node deployment on e4e-nas Container Manager.
# Generated from this template by terraform/e4e-nas/containers.tf via
# templatefile() — DO NOT edit a rendered copy on disk; change the template
# and re-run `tofu apply`.
#
# Architecture: ADR 0002 (Garage chosen over MinIO/RustFS/SeaweedFS) +
# ADR 0003 (runs on the NAS, not the krg-prod VM).
#
# Data layout:
#   /volume2/s3-data/meta  → /var/lib/garage/meta  (metadata, LMDB)
#   /volume2/s3-data/data  → /var/lib/garage/data  (object data)
# Snapshots come from Btrfs at the share level (spec/e4e-nas/snapshots.yml).
#
# Networking: `network_mode: host` — Garage exposes 4 ports (3900 S3 API,
# 3901 RPC, 3902 web, 3903 admin) and single-node needs no overlay. DSM's
# reverse proxy (sub-PR 4) will front the public-facing ones with TLS.
#
# Secrets are injected as env vars from terraform variables (garage_rpc_secret,
# garage_admin_token, garage_metrics_token) — never in the toml on disk.

services:
  garage:
    image: dxflrs/garage:${garage_image_tag}
    container_name: garage
    restart: unless-stopped
    network_mode: host
    volumes:
      - /volume2/s3-data/meta:/var/lib/garage/meta:rw
      - /volume2/s3-data/data:/var/lib/garage/data:rw
    environment:
      RUST_LOG: garage=info,garage_api=info,garage_block=info
    configs:
      - source: garage_config
        target: /etc/garage.toml
        mode: 0o400

configs:
  # Inlined via Compose `configs:` `content:` (v3.5+) so we don't need a
  # separate synology_filestation_file resource. Secrets are interpolated
  # by terraform's templatefile() at render time — Garage's env-var override
  # naming for nested [admin] section keys is finicky across versions, so
  # putting tokens directly in the toml is the unambiguous path. Trade-off:
  # secrets land in terraform state (state encryption matters — see
  # ../README.md "State encryption") AND inside the container's view of
  # /etc/garage.toml (mode 0400, root-owned).
  garage_config:
    content: |
      metadata_dir = "/var/lib/garage/meta"
      data_dir = "/var/lib/garage/data"
      db_engine = "lmdb"

      # Single-node cluster — no replication possible. Adding a second node
      # later requires changing this + a `garage layout assign` rebalance.
      replication_factor = 1

      compression_level = 2

      rpc_bind_addr = "[::]:3901"
      # network_mode: host → other nodes (if/when added) would reach us on
      # the NAS's primary IP. For single-node, loopback is fine.
      rpc_public_addr = "127.0.0.1:3901"
      rpc_secret = "${rpc_secret}"

      [s3_api]
      api_bind_addr = "[::]:3900"
      s3_region = "garage"
      # Bucket hostnames: <bucket>.s3.garage.e4e-nas.ucsd.edu
      # Sub-PR 4 wires DSM reverse proxy + Let's Encrypt for these.
      root_domain = ".s3.garage.e4e-nas.ucsd.edu"

      [s3_web]
      bind_addr = "[::]:3902"
      root_domain = ".web.garage.e4e-nas.ucsd.edu"
      index = "index.html"

      [admin]
      api_bind_addr = "[::]:3903"
      admin_token = "${admin_token}"
      metrics_token = "${metrics_token}"
