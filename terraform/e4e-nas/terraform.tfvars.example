# Copy to terraform.tfvars (gitignored) and fill in. Or export TF_VAR_* instead.
#
#   cp terraform.tfvars.example terraform.tfvars

dsm_host = "https://e4e-nas.ucsd.edu:6021"
dsm_user = "e4e-automation" # dedicated administrators-group API account, NOT the built-in 'admin'

# --- Secrets ------------------------------------------------------------------
# STRONGLY prefer `export TF_VAR_<name>=...` over writing secrets to a file on
# disk. The state file will hold the values either way (encrypt state once a
# backend is wired); the variable doesn't need to also be on disk.
#
# DSM API account password — rotate via #75 (synouser --setpw via OpenBao) when
# that lands; until then operator-managed:
#   export TF_VAR_dsm_password="$(yq -r '.synology_user_passwords."e4e-automation"' ~/.config/krg/secrets-syno.yml)"
#
# DSM TOTP secret — only if e4e-automation has 2FA enabled; base32 shared
# secret, NOT the 6-digit code, NOT the otpauth:// URI:
#   export TF_VAR_dsm_otp_secret="JBSWY3DPEHPK3PXP..."   # length 16-32

# --- Garage (S3) — per ADR 0002 + 0003 ----------------------------------------
# Garage secrets are NOT terraform-managed (the provider leaks string content
# in plan/error output). Operator manages /volume1/docker/garage/garage.toml
# directly on the NAS — see "Workloads → Garage" in README.md for the
# bootstrap workflow. No TF_VAR_garage_* env vars needed.
#
# Image pin is the one tunable on the terraform side:
# garage_image_tag = "v1.2.0"   # override to bump from the default in variables.tf