# OpenTofu / Terraform working files — never commit state (holds DSM secrets)
# or real tfvars.
.terraform/
# .terraform.lock.hcl is COMMITTED per workspace (the convention sibling
# workspaces — authentik/, grafana/, openbao/ — already follow). A committed
# lockfile pins provider versions across operators and CI. No global ignore.
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Per-target deploy secrets sourced by deploy/deploy-tofu.sh (VAULT_TOKEN, TF_VAR_*).
.deploy-env
# Operator-managed config files that may contain secrets (e.g. garage.toml has
# rpc_secret / admin_token / metrics_token — see terraform/e4e-nas/README.md
# and garage.toml.example). Filled-in copies are operator-local + shredded
# after scp to the NAS; the *.example template stays in the repo.
*.toml
!*.toml.example
# DSM config exports / SQL dumps — secret + PII-bearing, never commit (review locally only)
*.dss
*.sql
*.db
*_ConfBkp*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
