# OpenTofu / Terraform working files — never commit state (holds DSM secrets)
# or real tfvars.
.terraform/
# .terraform.lock.hcl is COMMITTED per workspace (the convention sibling
# workspaces — authentik/, grafana/, openbao/ — already follow). A committed
# lockfile pins provider versions across operators and CI. No global ignore.
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Per-target deploy secrets sourced by deploy/deploy-tofu.sh (VAULT_TOKEN, TF_VAR_*).
# The committed .deploy-env.example templates (what each target must export) stay
# trackable; only the filled-in .deploy-env is secret.
.deploy-env
!.deploy-env.example
# Operator-rendered config files that may carry secrets (historically
# garage.toml — rpc_secret / admin_token / metrics_token). The Ansible
# `synology_garage` role owns Garage config now (no_log + ansible-vault); the
# rule stays because *.tfvars already covers the canonical secret carrier
# and a stray rendered *.toml under terraform/ should never reach git.
*.toml
!*.toml.example
# DSM config exports / SQL dumps — secret + PII-bearing, never commit (review locally only)
*.dss
*.sql
*.db
*_ConfBkp*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
