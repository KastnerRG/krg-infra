# Install on krg-deploy as /var/lib/krg-admin/.secrets/tofu/grafana.deploy-env —
# the persistent secrets dir, NOT the repo (the CD checkout is re-cloned each run).
# Sourced by deploy/deploy-tofu.sh (set -a) right before `tofu apply`. The PRESENCE
# of that file flips this target from "skip" to "apply" — don't create it until
# Grafana (compose stack on krg-prod) is reachable.
#
#   mkdir -p /var/lib/krg-admin/.secrets/tofu
#   install -m600 terraform/grafana/.deploy-env.example \
#     /var/lib/krg-admin/.secrets/tofu/grafana.deploy-env   # then edit
#
# (An in-tree terraform/grafana/.deploy-env still works as a fallback for hand-runs.)

# OpenBao token is the ONLY secret this target needs: the Grafana admin password
# (providers.tf) and the Authentik OIDC client_id/secret (sso.tf) are both READ
# from OpenBao at plan time — nothing else is supplied here. Mint a token for the
# krg-deploy AppRole with read on secret/krg-prod/grafana-admin and
# secret/krg-prod/grafana-oidc.
VAULT_TOKEN="s.replace-with-krg-deploy-approle-token"

# Optional overrides (defaults in variables.tf):
# TF_VAR_grafana_url="https://dashboard.waiter.ucsd.edu"
# TF_VAR_authentik_url="https://auth.fabricant.ucsd.edu"
# TF_VAR_vault_addr="https://krg-vault.ucsd.edu:8200"
