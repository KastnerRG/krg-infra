# Install on krg-deploy as /var/lib/krg-admin/.secrets/tofu/authentik.deploy-env —
# the persistent secrets dir, NOT the repo (the CD checkout is re-cloned each run).
# Sourced by deploy/deploy-tofu.sh (set -a) right before `tofu apply`. The PRESENCE
# of that file flips this target from "skip" to "apply" — don't create it until
# Authentik (compose stack on krg-prod) is reachable and you have an admin API
# token + the AD bind password.
#
#   mkdir -p /var/lib/krg-admin/.secrets/tofu
#   install -m600 terraform/authentik/.deploy-env.example \
#     /var/lib/krg-admin/.secrets/tofu/authentik.deploy-env   # then edit
#
# (An in-tree terraform/authentik/.deploy-env still works as a fallback for hand-runs.)

# OpenBao token — this target READS no inputs from OpenBao but WRITES the
# generated OIDC client secrets back into it (vault_secrets.tf, roster_secrets.tf),
# so it needs write on secret/krg-prod/* and secret/krg-deploy/*. Mint a token for
# the krg-deploy AppRole (provisioned by the openbao target) rather than using root.
VAULT_TOKEN="s.replace-with-krg-deploy-approle-token"

# Authentik admin API token: Authentik UI → Admin → Directory → Tokens (or System
# → API Tokens), created against an admin/superuser account. Stored canonically at
# secret/krg-deploy/authentik-admin-token; mirror it here for the apply.
TF_VAR_authentik_token="replace-with-authentik-admin-api-token"

# Password for the `authentik-bind` service account in Samba AD (KRG.LOCAL) that
# the LDAP source/outpost binds with (ldap.tf, outpost.tf).
TF_VAR_ldap_bind_password="replace-with-authentik-bind-ad-password"

# Optional overrides (defaults in variables.tf):
# TF_VAR_authentik_url="https://auth.krg.ucsd.edu"
# TF_VAR_vault_addr="https://krg-vault.ucsd.edu:8200"
