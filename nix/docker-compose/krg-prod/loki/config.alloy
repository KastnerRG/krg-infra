// Grafana Alloy log-shipping config — replaces the EOL Promtail (end-of-life
// 2026-03-02). Reads the systemd journal → pushes to Loki.
// Alloy persists read offsets under --storage.path (set in compose.grafana.yml),
// the same role the old promtail positions.yaml served.
//
// NOTE: there is deliberately no /var/log/*log file source. On this NixOS host
// everything (incl. container logs via docker.service) goes to the journal;
// /var/log/*log matched only the binary /var/log/lastlog, so the old `varlogs`
// job shipped nothing. Removed rather than left as an empty, confusing label.

// Where everything is forwarded.
loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

// --- systemd journal ----------------------------------------------------------
// loki.source.journal drops the internal __journal_* labels before forwarding;
// keep the unit name by relabeling it, mirroring the old nixos_deploy_logs job.
loki.relabel "journal" {
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}
}

loki.source.journal "journal" {
	forward_to    = [loki.write.default.receiver]
	relabel_rules = loki.relabel.journal.rules
	labels        = {job = "nixos_rebuild"}
	max_age       = "12h"
	// path = "" → reads /var/log/journal and /run/log/journal (both mounted ro).
}
