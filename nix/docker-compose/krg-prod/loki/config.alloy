// Grafana Alloy log-shipping config — replaces the EOL Promtail (end-of-life
// 2026-03-02). Functional parity with the old loki/promtail-config.yaml:
//   1. tail /var/log/*log   2. read the systemd journal   → push to Loki.
// Alloy persists read offsets under --storage.path (set in compose.grafana.yml),
// the same role the old promtail positions.yaml served.

// Where everything is forwarded.
loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

// --- /var/log/*log files ------------------------------------------------------
local.file_match "varlogs" {
	path_targets = [{
		__path__ = "/var/log/*log",
		job      = "varlogs",
	}]
}

loki.source.file "varlogs" {
	targets    = local.file_match.varlogs.targets
	forward_to = [loki.write.default.receiver]
	// tail_from_end: on first boot (no stored offset yet) skip the existing
	// /var/log backlog so Alloy doesn't buffer the whole history into RAM and OOM —
	// matches the old promtail `tail_from_end: true`. After first run the stored
	// offset means a restart reads only the gap.
	tail_from_end = true
}

// --- systemd journal ----------------------------------------------------------
// loki.source.journal drops the internal __journal_* labels before forwarding;
// keep the unit name by relabeling it, mirroring the old nixos_deploy_logs job.
loki.relabel "journal" {
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}
}

loki.source.journal "journal" {
	forward_to    = [loki.write.default.receiver]
	relabel_rules = loki.relabel.journal.rules
	labels        = {job = "nixos_rebuild"}
	max_age       = "12h"
	// path = "" → reads /var/log/journal and /run/log/journal (both mounted ro).
}
