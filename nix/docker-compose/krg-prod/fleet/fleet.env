# Non-secret Fleet + MySQL config (committed; secrets live in ../.secrets/fleet.env).
# Shared as an env_file by the fleet, fleet_migrate, and fleet_mysql containers —
# each image ignores the vars it doesn't recognize (FLEET_* vs MYSQL_*).

# --- MySQL bootstrap (consumed by the mysql image on first init) ---
MYSQL_DATABASE=fleet
MYSQL_USER=fleet

# --- Fleet → MySQL / Redis ---
FLEET_MYSQL_ADDRESS=fleet_mysql:3306
FLEET_MYSQL_DATABASE=fleet
FLEET_MYSQL_USERNAME=fleet
FLEET_REDIS_ADDRESS=fleet_redis:6379

# TLS terminated at Traefik; Fleet serves plain HTTP on :8080 behind it.
FLEET_SERVER_TLS=false
FLEET_LOGGING_JSON=true
