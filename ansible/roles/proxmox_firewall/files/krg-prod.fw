[OPTIONS]

enable: 1

[RULES]

# krg-prod — lab-wide production stack (Traefik + Authentik + services).
# SSH restricted to UCSD + off-campus admin. HTTP/HTTPS public for Traefik
# (Let's Encrypt ACME challenges + service ingress).

IN SSH(ACCEPT)           -source +dc/ucsd -log nolog
IN SSH(ACCEPT)           -source +dc/ops  -log nolog
IN ACCEPT -p tcp -dport 80  -log nolog
IN ACCEPT -p tcp -dport 443 -log nolog

# Temporal gRPC frontend (workflows.krg.ucsd.edu:7233) — PUBLIC for off-site
# workers (e.g. the NRP cluster) + the terraform/temporal provider. Open to the
# internet on purpose: the frontend requires a client cert (mTLS), so the cert is
# the access control, not the network. See docs/temporal-mtls.md.
IN ACCEPT -p tcp -dport 7233 -log nolog

IN DROP -log nolog
