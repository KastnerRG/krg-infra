[OPTIONS]

enable: 1

[RULES]

# krg-prod — lab-wide production stack (Traefik + Authentik + services).
# SSH restricted to UCSD + off-campus admin. HTTP/HTTPS public for Traefik
# (Let's Encrypt ACME challenges + service ingress).

IN SSH(ACCEPT)           -source +dc/ucsd -log nolog
IN SSH(ACCEPT)           -source +dc/ops  -log nolog
IN ACCEPT -p tcp -dport 80  -log nolog
IN ACCEPT -p tcp -dport 443 -log nolog

# Temporal gRPC frontend (workflows.krg.ucsd.edu:7233) — PUBLIC for off-site
# workers (e.g. the NRP cluster) + the terraform/temporal provider. Open to the
# internet on purpose: the frontend requires a client cert (mTLS), so the cert is
# the access control, not the network. See docs/temporal-mtls.md.
IN ACCEPT -p tcp -dport 7233 -log nolog

# Authentik LDAP outpost (PVE login). The "KRG Authentik LDAP" realm on fabricant
# binds the authentik_ldap container's LDAPS port to authenticate Proxmox logins
# (ansible pve_ldap → krg-prod.ucsd.edu:6636). Source-restricted to fabricant — only
# the hypervisor's PVE daemon needs it. The container ALSO publishes plaintext 3389
# (debug), deliberately left to the DROP below so it stays closed at the perimeter.
# NOTE: this perimeter rule is REQUIRED even though Docker's publish bypasses the
# in-guest nftables firewall — the Proxmox per-guest firewall (this file) is a
# separate, default-deny layer in front of the VM. See docs/proxmox-auth.md.
IN ACCEPT -p tcp -dport 6636 -source 137.110.161.98 -log nolog # LDAPS — authentik LDAP outpost (PVE realm bind, fabricant only)

IN DROP -log nolog
